# Copy to infra/vast_config.env to override the global vast-run defaults for
# this repository. Prefer .vast/profile.toml for repo-specific runtime setup.

VAST_RUN_PREFERRED_PRICE=0.35
VAST_RUN_MAX_PRICE=0.35
VAST_RUN_GPU_MODEL="RTX 4090"
VAST_RUN_NUM_GPUS=1
VAST_RUN_MIN_RELIABILITY=0.98
VAST_RUN_DISK_GB=80
VAST_RUN_TEMPLATE_HASH="661d064bbda1f2a133816b6d55da07c3"
VAST_RUN_DOCKER_IMAGE=""
VAST_RUN_LOADING_TIMEOUT_SECONDS=900
VAST_RUN_MAX_INFRA_RETRIES=2
VAST_RUN_SYNC_PATHS="outputs,runs,eval_runs"

# Optional repo-specific debug reuse window.
# VAST_RUN_DEBUG_IDLE_MINUTES=12
